        </mxCell>

        <mxCell id="recursos" value="&lt;b&gt;Recurso — recursos.js&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='font-family:Courier New;font-size:10px'&gt;export const proyectos = {&lt;br&gt;&#160;&#160;listar: (filtros = {}) =&gt;&lt;br&gt;&#160;&#160;&#160;&#160;apiFetch(`/projects${qs({&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;included: '...', ...filtros })}`)&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;.then(lista),&lt;br&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#1e1e2e;fontColor=#e6e6e6;strokeColor=#444444;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
