        <mxCell id="useapi" value="&lt;b&gt;Hook — useApi.js&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='font-family:Courier New;font-size:10px'&gt;export function useApi(fn, deps = [],&lt;br&gt;&#160;&#160;{ inicial = null } = {}) {&lt;br&gt;&#160;&#160;const [estado, setEstado] = useState({&lt;br&gt;&#160;&#160;&#160;&#160;data: inicial, cargando: true, error: null })&lt;br&gt;&#160;&#160;const recargar = useCallback(async () =&gt; { ... })&lt;br&gt;&#160;&#160;return { data, cargando, error, recargar }&lt;br&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#1e1e2e;fontColor=#e6e6e6;strokeColor=#444444;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
