        <mxCell id="comp" value="&lt;b&gt;Componente — Propuestas.jsx&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='font-family:Courier New;font-size:10px'&gt;const { data, cargando, error, recargar }&lt;br&gt;&#160;&#160;= useApi(&lt;br&gt;&#160;&#160;() =&gt; proyectos.listar({&lt;br&gt;&#160;&#160;&#160;&#160;included: INCLUDE_PROYECTOS }),&lt;br&gt;&#160;&#160;[], { inicial: [] }&lt;br&gt;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#1e1e2e;fontColor=#e6e6e6;strokeColor=#444444;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
