APP_NAME=ProyecTwin-MVP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proyectwin_mvp
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo en local: el mensaje se escribe en storage/logs/laravel.log.
# Para correos reales, Brevo por API HTTP (sin SMTP):
#   MAIL_MAILER=brevo
#   BREVO_API_KEY=...            (app.brevo.com -> SMTP y API -> Claves API)
#   MAIL_FROM_ADDRESS=<remitente verificado en Brevo>
# Con la seguridad por IP activa en Brevo hay que autorizar la IP de salida
# del servidor (Railway usa IPs dinamicas: se recomienda desactivarla).
MAIL_MAILER=log
BREVO_API_KEY=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-responder@proyecttwin.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:4173,127.0.0.1:4173
# Minutos de vida de los tokens Bearer (móvil/clientes sin sesión). El SPA usa
# cookie de sesión y no depende de este valor.
SANCTUM_EXPIRATION=1440

# Producción: define SESSION_SECURE_COOKIE=true (HTTPS) y sirve el SPA en el
# mismo sitio que la API (SameSite=Lax) o ajusta config/session.php si el SPA
# vive en otro dominio. Los tokens Sanctum no expiran por defecto (config/sanctum.php).

APP_TIMEZONE=America/Bogota

# Limite de peticiones por minuto y usuario en la API (default 60 en produccion).
# En local se recomienda subirlo (600) porque la suite E2E abre muchas paginas.
API_RATE_LIMIT=600

# App Android (deteccion de actualizaciones; ver config/app_version.php).
# Publicar una version nueva = subir el APK y actualizar estas variables.
# ANDROID_APP_ENFORCE_MINIMUM solo con politica de actualizacion obligatoria.
ANDROID_APP_VERSION=1.0.0
ANDROID_APP_MIN_VERSION=1.0.0
ANDROID_APP_ENFORCE_MINIMUM=false
ANDROID_APP_DOWNLOAD_URL=
ANDROID_APP_RELEASE_NOTES=
